{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run check --workspace=@ptc/shared && npm run check --workspace=@ptc/server",
    "watchPatterns": [
      "/apps/server/**",
      "/packages/shared/**",
      "/package.json",
      "/package-lock.json",
      "/railway.json",
      "/.nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@ptc/server",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
