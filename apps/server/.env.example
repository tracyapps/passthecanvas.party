# Copy to .env and fill in. Never commit .env.
PORT=8787

# LiveKit (cloud.livekit.io → your project → Settings → Keys)
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Default seconds per turn
TURN_SECONDS=90

# Accounts: Clerk email verification code + optional Discord, configured in Clerk.
# The secret key and Railway Postgres URL belong only on the server.
CLERK_SECRET_KEY=
DATABASE_URL=
# Exact frontend origins, comma separated. No wildcards. Match the Vite port in use.
ACCOUNT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5192
# First authenticated account-storage request creates account_workspaces if needed.
# Railway Postgres connection SSL settings must follow the provided connection URL.

# Optional approved Resend account mail. Disabled unless every value is configured.
# Set up a verified sender domain and turn OFF tracking in Resend before enabling.
ACCOUNT_EMAIL_ENABLED=0
RESEND_API_KEY=
RESEND_FROM=
ACCOUNT_SITE_ORIGIN=https://passthecanvas-party.vercel.app
# Opted-in account recipients only; Clerk supplies their verified primary email.
# Worker leases/retries live in Postgres; no browser tab or cron service is needed.
