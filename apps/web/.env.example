# Copy to .env. Clerk's publishable key is intentionally browser-visible.
VITE_CLERK_PUBLISHABLE_KEY=
# Empty uses the same origin (Vite proxies /api locally). For a separate Railway
# server, use its HTTPS origin and include this frontend in ACCOUNT_ALLOWED_ORIGINS.
VITE_ACCOUNT_API_URL=

# Public origin for static link-preview metadata. Set to the final Vercel/custom domain.
VITE_PUBLIC_SITE_URL=https://passthecanvas-party.vercel.app
