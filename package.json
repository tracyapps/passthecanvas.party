{
  "name": "passthecanvas",
  "private": true,
  "version": "0.0.1",
  "description": "Pass the Canvas — a virtual pass-the-canvas painting party",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ptc/server & npm run dev --workspace=@ptc/web",
    "dev:web": "npm run dev --workspace=@ptc/web",
    "dev:server": "npm run dev --workspace=@ptc/server",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspace=@ptc/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
